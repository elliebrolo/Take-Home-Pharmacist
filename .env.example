# --- AI model (chatbot AND consultation transcript processing use the same settings) ---
# LLM_PROVIDER: "gemini" or "openai". If unset, the provider whose key is set is used (Gemini if both are).
# A chosen provider without its key means "no model": chat forwards questions to the pharmacist and
# transcript reading is off. It never silently switches provider.
LLM_PROVIDER=""

# Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Default gemini-3.8-flash (not verified: set a model your key can use).
GEMINI_MODEL=""

# OpenAI
OPENAI_API_KEY="MY_OPENAI_API_KEY"
# Default gpt-5.4-mini.
OPENAI_MODEL=""
# Optional: an OpenAI-compatible endpoint (default https://api.openai.com/v1).
OPENAI_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Pharmacist sign-in passcode. If unset in development, a random one is printed when the server starts.
# Required in production, together with SESSION_SECRET (a long random string).
PHARMACIST_PASSCODE=""
SESSION_SECRET=""

# Optional: per-patient access codes, "PT-8821:code1,PT-9410:code2". Patients with no code
# can sign in without one ONLY outside production (demo convenience).
PATIENT_CODES=""

# Optional: share of validated answers sent to pharmacist audit (default 0.2),
# and the database file (default data/app.db).
AUDIT_RATE="0.2"
DB_FILE=""

# Optional: notify pharmacists of emergency and urgent queue items without the workspace open.
# A Slack-style incoming webhook (https). The message holds only the item number and reason, never
# patient names or message text. Leave empty to turn off.
URGENT_WEBHOOK_URL=""

# Optional: hours between automatic re-reads of cached FDA labels (default 24, 0 = off).
LABEL_REFRESH_HOURS="24"
